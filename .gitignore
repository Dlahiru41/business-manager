# Build output. IDE output folders (out/, bin/) are ignored, but never source packages of the same name such as
# adapter/out/ (hexagonal outbound adapters).
build/
out/
bin/
!**/src/**/out/
!**/src/**/bin/
.gradle/
.kotlin/

# IDE
.idea/
*.iml
.vscode/
*.swp

# Local secrets (never commit)
.env
*.local.env
http/http-client.private.env.json

# OS
.DS_Store
Thumbs.db

# Claude local settings
.claude/settings.local.json
