# Sales module (contracts/openapi/sales.yaml). Get tokens with auth.http first, then run tenant.http (locationId),
# catalog.http and pricing.http (eggVariantId, eggPieceUnitId; retail egg price 55.00) and party.http (customerId).
# Bill ids are generated by the till (UUIDv7 in production; any UUID here) and numbers are <prefix>-<6 digits>.

### A register for the front counter (bill prefix R1)
POST {{baseUrl}}/api/v1/registers
Authorization: Bearer {{ownerToken}}
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{"code": "R1", "name": "Front counter", "locationId": "{{locationId}}", "billPrefix": "R1"}

> {% client.global.set("registerId", response.body.id); %}

### Open its shift (SAL-12: online bills need an open shift)
POST {{baseUrl}}/api/v1/shifts
Authorization: Bearer {{cashierToken}}
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{"registerId": "{{registerId}}"}

> {% client.global.set("shiftId", response.body.id); %}

### A draft bill: 10 eggs (SAL-02, online path)
POST {{baseUrl}}/api/v1/bills
Authorization: Bearer {{cashierToken}}
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{"id": "{{$uuid}}", "number": "R1-000001", "registerId": "{{registerId}}", "channel": "RETAIL",
 "lines": [{"id": "{{$uuid}}", "variantId": "{{eggVariantId}}", "packagingUnitId": "{{eggPieceUnitId}}",
            "qty": "10", "unitPrice": "55.00"}]}

> {%
client.global.set("draftId", response.body.id);
client.global.set("draftEtag", response.headers.valueOf("ETag"));
%}

### Change the draft under its ETag: 12 eggs
PATCH {{baseUrl}}/api/v1/bills/{{draftId}}
Authorization: Bearer {{cashierToken}}
Content-Type: application/json
If-Match: {{draftEtag}}

{"lines": [{"id": "{{$uuid}}", "variantId": "{{eggVariantId}}", "packagingUnitId": "{{eggPieceUnitId}}",
            "qty": "12", "unitPrice": "55.00"}]}

### Complete it with cash (SAL-04 totals must match; SAL-06 change = tendered − amount) → SaleCompleted
POST {{baseUrl}}/api/v1/bills/{{draftId}}/complete
Authorization: Bearer {{cashierToken}}
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{"tenders": [{"id": "{{$uuid}}", "method": "CASH", "amount": "660.00", "tendered": "1000.00"}],
 "totals": {"subtotal": "660.00", "discountTotal": "0.00", "taxTotal": "0.00", "grandTotal": "660.00"}}

> {% client.global.set("billLineId", response.body.lines[0].id); %}

### Direct submission of a completed bill, as a till does: cash and card (SAL-02, SAL-06)
POST {{baseUrl}}/api/v1/bills
Authorization: Bearer {{cashierToken}}
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{"id": "{{$uuid}}", "number": "R1-000002", "registerId": "{{registerId}}", "channel": "RETAIL",
 "lines": [{"id": "{{$uuid}}", "variantId": "{{eggVariantId}}", "packagingUnitId": "{{eggPieceUnitId}}",
            "qty": "2", "unitPrice": "55.00"}],
 "complete": true,
 "tenders": [{"id": "{{$uuid}}", "method": "CASH", "amount": "60.00", "tendered": "100.00"},
             {"id": "{{$uuid}}", "method": "CARD", "amount": "50.00", "reference": "AUTH-4471"}],
 "totals": {"subtotal": "110.00", "discountTotal": "0.00", "taxTotal": "0.00", "grandTotal": "110.00"}}

> {% client.global.set("cardBillId", response.body.id); %}

### Void it (SAL-09: same business date, reason, approver with sales:void) → SaleVoided
POST {{baseUrl}}/api/v1/bills/{{cardBillId}}/void
Authorization: Bearer {{ownerToken}}
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{"reason": "Wrong customer", "approvedBy": "{{managerUserId}}"}

### Return 2 eggs of the cash bill, back to stock (SAL-10; credit note CN-000001) → SaleReturned
POST {{baseUrl}}/api/v1/bills/{{draftId}}/returns
Authorization: Bearer {{ownerToken}}
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{"id": "{{$uuid}}", "reason": "Cracked",
 "lines": [{"billLineId": "{{billLineId}}", "qty": "2", "restock": true}]}

### A credit sale to a customer (SAL-07: needs allowCreditSales in the sales settings and a credit policy)
POST {{baseUrl}}/api/v1/bills
Authorization: Bearer {{cashierToken}}
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{"id": "{{$uuid}}", "number": "R1-000003", "registerId": "{{registerId}}", "channel": "RETAIL",
 "customerId": "{{customerId}}",
 "lines": [{"id": "{{$uuid}}", "variantId": "{{eggVariantId}}", "packagingUnitId": "{{eggPieceUnitId}}",
            "qty": "30", "unitPrice": "55.00"}],
 "complete": true,
 "tenders": [{"id": "{{$uuid}}", "method": "CREDIT", "amount": "1650.00"}],
 "totals": {"subtotal": "1650.00", "discountTotal": "0.00", "taxTotal": "0.00", "grandTotal": "1650.00"}}

### Bills of today with a flag (offline submissions accepted with differences)
GET {{baseUrl}}/api/v1/bills?flagged=true
Authorization: Bearer {{ownerToken}}

### Bills of the register
GET {{baseUrl}}/api/v1/bills?registerId={{registerId}}
Authorization: Bearer {{ownerToken}}

### Credit notes of the cash bill
GET {{baseUrl}}/api/v1/credit-notes?billId={{draftId}}
Authorization: Bearer {{ownerToken}}

### Close the shift
POST {{baseUrl}}/api/v1/shifts/{{shiftId}}/close
Authorization: Bearer {{cashierToken}}
Content-Type: application/json
Idempotency-Key: {{$uuid}}

{}
