{
  "realm": "bmp",
  "enabled": true,
  "displayName": "Business Management Platform",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "failureFactor": 10,
  "passwordPolicy": "length(8) and notUsername",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": false,
  "smtpServer": {
    "host": "${BMP_SMTP_HOST:mailpit}",
    "port": "${BMP_SMTP_PORT:1025}",
    "from": "no-reply@bmp.example.invalid",
    "fromDisplayName": "BMP"
  },
  "roles": {
    "realm": [
      {
        "name": "OWNER",
        "description": "All tenant permissions"
      },
      {
        "name": "MANAGER",
        "description": "Catalog, pricing, inventory, procurement, sales, payments, reports"
      },
      {
        "name": "CASHIER",
        "description": "Billing at the till"
      },
      {
        "name": "STOREKEEPER",
        "description": "Receiving, transformations, counts"
      },
      {
        "name": "ACCOUNTANT",
        "description": "Finance and reports"
      },
      {
        "name": "DEVICE",
        "description": "A registered till (service accounts of device clients)"
      },
      {
        "name": "platform_admin",
        "description": "Operates the platform; may act for a tenant via X-Tenant-Id (audited)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "bmp-api",
      "name": "BMP API (resource server audience)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "bmp-dev-cli",
      "name": "BMP developer CLI (.http files, local only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "device_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "device_id",
            "claim.name": "device_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "bmp-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "bmp-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "bmp-admin",
      "name": "BMP platform service account (user and device provisioning)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${BMP_KEYCLOAK_ADMIN_CLIENT_SECRET:local-dev-admin-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
