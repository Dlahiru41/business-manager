# Copy to deploy/local/.env (git-ignored) to override the local defaults. Local development only: never reuse these
# values anywhere else. The app reads the same names (see app/src/main/resources/application-local.yaml).
BMP_POSTGRES_PASSWORD=postgres
# Host port of the database; set BMP_DB_URL for the app to match when you change it.
BMP_POSTGRES_PORT=5432
BMP_MIGRATOR_PASSWORD=bmp_migrator
BMP_APP_PASSWORD=bmp_app
BMP_PLATFORM_ADMIN_PASSWORD=bmp_platform_admin
BMP_KEYCLOAK_ADMIN=admin
BMP_KEYCLOAK_ADMIN_PASSWORD=admin
BMP_KEYCLOAK_ADMIN_CLIENT_SECRET=local-dev-admin-secret
BMP_DEV_USER_PASSWORD=Dev-Passw0rd!
